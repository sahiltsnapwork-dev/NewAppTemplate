# GetQuote Module — Environment Variables
# Copy this file to .env and fill in actual values

# Primary API server (openApiClient)
API_BASE_URL=https://api.hdfcsec.com

# MS UAT server (msUatClient) — used for MS-specific endpoints
MS_UAT_BASE_URL=https://msuat.hdfcsec.com

# CMOTS content services (cmotsClient) — news, events, bulk/block
CMOTS_BASE_URL=https://cmots.hdfcsec.com/mcontent-services

# Auth token (populated at runtime by token refresh logic)
# AUTH_TOKEN=

# Mock configuration override (true = use mock data, false = use real API)
# MOCK_ENABLED=true
